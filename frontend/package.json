{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:all": "concurrently -n web,indexer -c cyan,magenta \"next dev --webpack\" \"npm run indexer\"",
    "dev:refresh": "npm run db:reset:local && npm run dev:all",
    "dev:web": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset:local": "tsx scripts/reset-local-db.ts && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "indexer": "tsx watch scripts/indexer.ts",
    "indexer:reindex": "tsx scripts/reindex-campaigns.ts",
    "auto:expire": "tsx scripts/auto-expire.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-org/account": "^2.5.9",
    "@metamask/connect-evm": "^2.1.1",
    "@prisma/client": "^6.8.0",
    "@reown/appkit": "^1.6.0",
    "@reown/appkit-adapter-wagmi": "^1.6.0",
    "@tanstack/react-query": "^5.62.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/svm": "^2.23.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0",
    "viem": "^2.55.11",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
